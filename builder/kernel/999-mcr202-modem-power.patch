--- a/arch/arm/boot/dts/allwinner/sun8i-h3-nanopi-neo.dts
+++ b/arch/arm/boot/dts/allwinner/sun8i-h3-nanopi-neo.dts
@@ -48,6 +48,23 @@
 	};
 };
 
+&pio {
+	mcr202_modem_power_hog: mcr202-modem-power-hog {
+		gpio-hog;
+		gpios = <4 12 GPIO_ACTIVE_HIGH>; /* PE12 / Linux GPIO140 */
+		output-high;
+		line-name = "mcr202-modem-power";
+	};
+};
+
+/* MCR-202 routes its internal LAN9514 hubs / modem slots through
+ * the H3 USB1 and USB2 host controllers.  Stock NanoPi NEO leaves
+ * these controllers disabled, which makes LAN1/LAN2 and the first
+ * two onboard modem paths disappear completely. */
+&ehci1 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
 &ehci0 {
 	status = "okay";
 };
@@ -61,8 +78,16 @@
 &ohci0 {
 	status = "okay";
 };
 
+&ohci1 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
 &usb_otg {
 	status = "okay";
 	dr_mode = "peripheral";
 };
